# SIH 26108 — Environment Configuration Template
# Copy this file to .env for local deployment. Never commit actual credentials to repository.

# Knowledge Graph Database Configuration (Neo4j / In-Memory Fallback)
GRAPH_DATABASE_URL=bolt://localhost:7687
GRAPH_DATABASE_USERNAME=neo4j
GRAPH_DATABASE_PASSWORD=your_password_here

# Vector Search Database & Model Configuration
VECTOR_DATABASE_URL=local://indexes/faiss_index
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
CROSS_ENCODER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2

# API Server Configuration
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Application Environment
APP_ENV=production
DEBUG=false
